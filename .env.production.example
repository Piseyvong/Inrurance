# Copy this to .env.production and fill in real values. .env.production
# should NEVER be committed — it already matches the .env pattern in
# .gitignore, but double-check before you `git add`.
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Database (compose's own "postgres" service) ------------------------
# Used both to configure the bundled postgres container and to build the
# backend's DATABASE_URL (docker-compose.prod.yml wires POSTGRES_HOST/PORT to
# the "postgres" service automatically — don't set DATABASE_URL here).
POSTGRES_DB=insurance_claims
POSTGRES_USER=insurance_app
POSTGRES_PASSWORD=change-me-to-a-real-password

# If you're pointing at an external managed database instead (Azure
# Database for PostgreSQL, RDS, etc.), remove the "postgres" service from
# docker-compose.prod.yml and set DATABASE_URL here instead, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@your-server.postgres.database.azure.com:5432/insurance_claims?ssl=require

# --- Ports published on the host -----------------------------------------
# Picked to avoid the other apps already running on this VM (per `docker ps`:
# 80, 8000-8002, 8010, 8080, 8082-8085, 5052, 5433 are all taken). The
# postgres service in this stack is never published to the host at all, so
# it can't collide with anyone else's 5432/5433 regardless of these two.
# Re-check `docker ps` / `sudo ss -tlnp` before deploying in case something
# changed since this list was taken.
BACKEND_PUBLISHED_PORT=8011
FRONTEND_PUBLISHED_PORT=8086

# --- Frontend <-> backend addressing --------------------------------------
# The address a BROWSER can reach the backend at — your public domain or
# server IP, not the "backend" container hostname. This is compiled into the
# frontend's JS bundle at build time: changing it later requires
# `docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build frontend`.
VITE_API_BASE_URL=http://your-domain-or-server-ip:8011

# The reverse of the above: which browser-facing origin(s) are allowed to
# call the backend. Must match the frontend's real origin (scheme+host+
# FRONTEND_PUBLISHED_PORT), comma-separated if there's more than one (e.g.
# www + bare domain).
CORS_ORIGINS=http://your-domain-or-server-ip:8086

# --- OCR ---------------------------------------------------------------
# Do NOT set TESSERACT_CMD or TESSERACT_TESSDATA_DIR here — the backend
# image already points them at its own Linux Tesseract install (see
# Dockerfile). Copying the Windows paths from a local dev .env here will
# break OCR in the container.
OCR_PROVIDER=tesseract
OCR_POSTPROCESSING_ENABLED=true
MAX_UPLOAD_BYTES=10485760

# --- Azure OpenAI (Microsoft Foundry) --------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- Backend process ------------------------------------------------------
# uvicorn worker processes. A reasonable starting point is (CPU cores), tune
# after watching real load.
UVICORN_WORKERS=2

# --- Company/contact details shown to customers ---------------------------
COMPANY_NAME=Insurance AI
CONSULTATION_PHONE=
CONSULTATION_EMAIL=
OFFICE_HOURS=
OFFICE_LOCATION=
