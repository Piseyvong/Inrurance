# Database connection.
# Azure PostgreSQL example:
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<server-name>.postgres.database.azure.com:5432/<database-name>?ssl=require

# Local PostgreSQL fallback example. Leave commented when using DATABASE_URL.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=insurance_claims_demo
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

UPLOAD_DIR=uploads
PROCESSED_DIR=processed_uploads
PROCESSING_LOG_PATH=logs/processing_results.jsonl
MAX_UPLOAD_BYTES=10485760

# OCR_PROVIDER=tesseract uses the local Tesseract engine with Khmer and English data.
# OCR_PROVIDER=demo_text is only for synthetic local API testing.
OCR_PROVIDER=tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGES=khm+eng
# Use a path without spaces on Windows so Tesseract can read it reliably.
TESSERACT_TESSDATA_DIR=C:\tesseract-tessdata
# Send successful Tesseract text to Azure OpenAI for evidence-preserving cleanup.
OCR_POSTPROCESSING_ENABLED=true

# Azure OpenAI in Microsoft Foundry.
# Use the Azure OpenAI endpoint from View endpoint, not the Foundry Project endpoint.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional local tuning.
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Comma-separated allowed origins for the local Vite frontend.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./insurance_demo.db
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

COMPANY_NAME=Insurance AI
CONSULTATION_PHONE=
CONSULTATION_EMAIL=
OFFICE_HOURS=
OFFICE_LOCATION=
